CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

ADMIN_USER_IDS=

DATABASE_URL=

# Cloudflare R2 (project story images).
# Canonical objects live at projects/... (private API access).
# Published copies are promoted to public/projects/... and must be the only
# prefix exposed by R2_PUBLIC_BASE_URL (Worker / transform rule).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_FROM=
ANALYTICS_SALT=
# Redis Cloud (redis.io/cloud). Use the TLS URL (rediss://...) so contact/
# analytics/health rate limits share one counter across Vercel instances.
REDIS_URL=
# Optional local override: force in-memory buckets even if REDIS_URL is set.
# RATE_LIMIT_FORCE_MEMORY=1
CRON_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
