# Canonical site origin used for metadata, Open Graph, sitemap and JSON-LD.
# No trailing slash. Defaults to https://sahilbzy.com when unset.
NEXT_PUBLIC_SITE_URL=https://sahilbzy.com

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# Comma-separated Clerk user IDs allowed into /admin and /api/admin.
ADMIN_USER_IDS=

# Phase 7 data and messaging
DATABASE_URL=
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_FROM=
ANALYTICS_SALT=
